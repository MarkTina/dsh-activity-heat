{
  "name": "@local/activity-heat",
  "version": "0.3.0",
  "private": true,
  "description": "Heat marks that make the sessions and workspaces with the most recent conversations obvious: a sidebar entry, a heat dot before each session title and a hover-card heat section. | 会话热度：用热度标识最近发生过对话的会话与工作区。",
  "icon": "icon.svg",
  "type": "module",
  "author": "MarkTina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarkTina/dsh-activity-heat.git"
  },
  "homepage": "https://github.com/MarkTina/dsh-activity-heat#readme",
  "bugs": {
    "url": "https://github.com/MarkTina/dsh-activity-heat/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./assets/*": "./assets/*",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/active.png",
    "assets/active.gif",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "harness",
    "session",
    "workspace",
    "recency",
    "activity",
    "heat",
    "sidebar",
    "panel"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/panel.cjs && node test/menu.cjs && node test/shortcut.cjs && node test/boot-timing.cjs && node test/locale.cjs && node test/assets.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  }
}
